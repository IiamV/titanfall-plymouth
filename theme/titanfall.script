# Palette constants are substituted by scripts/build.py.
@MOTION_SETUP@
Window.SetBackgroundTopColor(@BG@, @BG@, @BG@);
Window.SetBackgroundBottomColor(@BG@, @BG@, @BG@);
width = Window.GetWidth();
height = Window.GetHeight();
# Stretch panel coordinates to the viewport; preserve the emblem's aspect ratio.
scale_x = width / 960;
scale_y = height / 540;
origin_x = Window.GetX(); origin_y = Window.GetY();
window_x = origin_x; window_y = origin_y;
left_original = Image("left.png"); right_original = Image("right.png");
bottom_original = Image("bottom.png"); top_original = Image("top.png");
logo_original = Image("marauder-logo.png");
left = Sprite(); right = Sprite(); bottom = Sprite(); top = Sprite(); logo = Sprite();
fun resize_layout()
{
    global.width = Window.GetWidth(); global.height = Window.GetHeight();
    global.origin_x = Window.GetX(); global.origin_y = Window.GetY();
    global.window_x = origin_x; global.window_y = origin_y;
    global.scale_x = width / 960; global.scale_y = height / 540;
    global.left_image = left_original.Scale(bounds["left"][2] * scale_x, bounds["left"][3] * scale_y);
    global.right_image = right_original.Scale(bounds["right"][2] * scale_x, bounds["right"][3] * scale_y);
    global.bottom_image = bottom_original.Scale(bounds["bottom"][2] * scale_x, bounds["bottom"][3] * scale_y);
    global.top_image = top_original.Scale(bounds["top"][2] * scale_x, bounds["top"][3] * scale_y);
    global.logo_size = Math.Max(1, Math.Int(128 * Math.Min(scale_x, scale_y)));
    global.logo_image = logo_original.Scale(logo_size, logo_size);
    if (panel)
    {
        panel.SetImage(Image("panel.png").Scale(width, Math.Max(100, height * 0.23)));
        panel.SetPosition(origin_x, origin_y + height * 0.39, 100);
    }
    if (message_sprite) message_sprite.SetPosition(origin_x + 20, origin_y + height - 45, 105);
}
fun reveal(sprite, image, way, progress, x, y, z, fade)
{
    sprite.SetOpacity(0);
    if (progress <= 0) return;
    image_width = image.GetWidth();
    image_height = image.GetHeight();
    crop_x = 0; crop_y = 0;
    crop_width = image_width; crop_height = image_height;
    if (way == "right" || way == "left")
    {
        crop_width = Math.Max(1, Math.Int(image_width * progress));
        if (way == "left") crop_x = image_width - crop_width;
    }
    else
    {
        crop_height = Math.Max(1, Math.Int(image_height * progress));
        if (way == "up") crop_y = image_height - crop_height;
    }
    sprite.SetImage(image.Crop(crop_x, crop_y, crop_width, crop_height));
    sprite.SetPosition(x + crop_x, y + crop_y, z);
    sprite.SetOpacity(fade);
}
fun sample(keys, seconds)
{
    if (seconds <= keys[0][0]) return keys[0][1];
    for (index = 1; keys[index]; index++)
    {
        if (seconds <= keys[index][0])
        {
            previous = keys[index - 1];
            next = keys[index];
            fraction = (seconds - previous[0]) / (next[0] - previous[0]);
            return previous[1] + fraction * (next[1] - previous[1]);
        }
    }
    return keys[index - 1][1];
}
# Authentication stays readable throughout the sequence and after the final fade.
panel = Sprite(Image("panel.png").Scale(width, Math.Max(100, height * 0.23)));
panel.SetPosition(Window.GetX(), Window.GetY() + height * 0.39, 100);
panel.SetOpacity(0);
prompt_sprite = Sprite();
entry_sprite = Sprite();
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 20, Window.GetY() + height - 45, 105);
fun center_text(sprite, text, y)
{
    image = Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 14");
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (width - image.GetWidth()) / 2,
                       Window.GetY() + height * y, 101);
}
fun display_normal()
{
    panel.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
}
fun display_prompt(prompt, answer)
{
    panel.SetOpacity(1);
    center_text(prompt_sprite, prompt, 0.43);
    center_text(entry_sprite, answer, 0.51);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
}
fun display_password(prompt, bullets)
{
    answer = "";
    for (i = 0; i < bullets; i++) answer += "*";
    display_prompt(prompt, answer);
}
fun display_message(text)
{
    message_sprite.SetImage(Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 12"));
    message_sprite.SetOpacity(1);
}
fun hide_message(text) { message_sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_prompt);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
tick = 0;
fun refresh()
{
    if (width != Window.GetWidth() || height != Window.GetHeight() ||
        window_x != Window.GetX() || window_y != Window.GetY()) resize_layout();
    seconds = tick / fps;
    fade = 1 - Math.Clamp((seconds - fade_start) / fade_duration, 0, 1);
    reveal(left, left_image, direction["left"], sample(lighting["left"], seconds),
           origin_x + bounds["left"][0] * scale_x, origin_y + bounds["left"][1] * scale_y, 1, fade);
    reveal(right, right_image, direction["right"], sample(lighting["right"], seconds),
           origin_x + bounds["right"][0] * scale_x, origin_y + bounds["right"][1] * scale_y, 1, fade);
    reveal(bottom, bottom_image, direction["bottom"], sample(lighting["bottom"], seconds),
           origin_x + bounds["bottom"][0] * scale_x, origin_y + bounds["bottom"][1] * scale_y, 2, fade);
    reveal(top, top_image, direction["top"], sample(lighting["top"], seconds),
           origin_x + bounds["top"][0] * scale_x, origin_y + bounds["top"][1] * scale_y, 3, fade);
    # Reveal the fixed emblem with the same scan front crossing the main panel.
    front = bounds["top"][3] * scale_y * sample(lighting["top"], seconds);
    logo_progress = Math.Clamp((front - ((234 - bounds["top"][1]) * scale_y - logo_size / 2)) / logo_size, 0, 1);
    reveal(logo, logo_image, "down", logo_progress,
           origin_x + 480 * scale_x - logo_size / 2, origin_y + 234 * scale_y - logo_size / 2, 4, fade);
    tick++;
}
Plymouth.SetRefreshRate(fps);
resize_layout();
refresh();
Plymouth.SetRefreshFunction(refresh);
