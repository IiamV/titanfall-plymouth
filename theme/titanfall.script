# Palette constants are substituted by scripts/build.py.
@MOTION_SETUP@
Window.SetBackgroundTopColor(@BG@, @BG@, @BG@);
Window.SetBackgroundBottomColor(@BG@, @BG@, @BG@);
width = Window.GetWidth();
height = Window.GetHeight();
# Stretch panel coordinates to the viewport.
scale_x = width / 960;
scale_y = height / 540;
origin_x = Window.GetX(); origin_y = Window.GetY();
window_x = origin_x; window_y = origin_y;
left_original = Image("left.png"); right_original = Image("right.png");
bottom_original = Image("bottom.png"); top_original = Image("top.png");
assembled_original = Image("assembled.png");
assembled_sprite = Sprite(); assembled_sprite.SetZ(-100); assembled_sprite.SetOpacity(0);
left_face_original = Image("face-left.png"); right_face_original = Image("face-right.png");
bottom_face_original = Image("face-bottom.png"); top_face_original = Image("face-top.png");
left = Sprite(); right = Sprite(); bottom = Sprite(); top = Sprite();
left_face = Sprite(); right_face = Sprite(); bottom_face = Sprite(); top_face = Sprite();
fun fit_panel(image, rectangle)
{
    # Scale shared endpoints so adjacent panels cannot leave rounding gaps.
    target_width = Math.Int((rectangle[0] + rectangle[2]) * scale_x) - Math.Int(rectangle[0] * scale_x);
    target_height = Math.Int((rectangle[1] + rectangle[3]) * scale_y) - Math.Int(rectangle[1] * scale_y);
    return image.Scale(Math.Max(1, target_width), Math.Max(1, target_height));
}
fun resize_layout()
{
    global.width = Window.GetWidth(); global.height = Window.GetHeight();
    global.origin_x = Window.GetX(); global.origin_y = Window.GetY();
    global.window_x = origin_x; global.window_y = origin_y;
    global.scale_x = width / 960; global.scale_y = height / 540;
    global.left_image = fit_panel(left_original, bounds["left"]);
    global.right_image = fit_panel(right_original, bounds["right"]);
    global.bottom_image = fit_panel(bottom_original, bounds["bottom"]);
    global.top_image = fit_panel(top_original, bounds["top"]);
    global.left_face_image = fit_panel(left_face_original, bounds["left"]);
    global.right_face_image = fit_panel(right_face_original, bounds["right"]);
    global.bottom_face_image = fit_panel(bottom_face_original, bounds["bottom"]);
    global.top_face_image = fit_panel(top_face_original, bounds["top"]);
    assembled_sprite.SetImage(assembled_original.Scale(width, height));
    assembled_sprite.SetPosition(origin_x, origin_y, -100);
    if (panel)
    {
        panel.SetImage(Image("panel.png").Scale(width, Math.Max(100, height * 0.23)));
        panel.SetPosition(origin_x, origin_y + height * 0.39, 100);
    }
    if (message_sprite) message_sprite.SetPosition(origin_x + 20, origin_y + height - 45, 105);
}
fun slide(sprite, image, way, progress, x, y, z, opacity)
{
    sprite.SetOpacity(0);
    if (progress <= 0 || opacity <= 0) return;
    offset_x = 0; offset_y = 0;
    if (way == "right") offset_x = -image.GetWidth() * (1 - progress);
    if (way == "left") offset_x = image.GetWidth() * (1 - progress);
    if (way == "down") offset_y = -image.GetHeight() * (1 - progress);
    if (way == "up") offset_y = image.GetHeight() * (1 - progress);
    sprite.SetImage(image);
    sprite.SetPosition(x + Math.Int(offset_x), y + Math.Int(offset_y), z);
    sprite.SetOpacity(opacity);
}
fun show_panel(face, outline, face_image, outline_image, way, progress, x, y, z, fade, complete)
{
    slide(face, face_image, way, progress, x, y, z, !complete);
    slide(outline, outline_image, way, progress, x, y, z + 10, fade);
}
fun sample(keys, seconds)
{
    if (seconds <= keys[0][0]) return keys[0][1];
    for (index = 1; keys[index]; index++)
    {
        if (seconds <= keys[index][0])
        {
            previous = keys[index - 1];
            next = keys[index];
            fraction = (seconds - previous[0]) / (next[0] - previous[0]);
            return previous[1] + fraction * (next[1] - previous[1]);
        }
    }
    return keys[index - 1][1];
}
# Authentication stays readable throughout the sequence and after the final fade.
panel = Sprite(Image("panel.png").Scale(width, Math.Max(100, height * 0.23)));
panel.SetPosition(Window.GetX(), Window.GetY() + height * 0.39, 100);
panel.SetOpacity(0);
prompt_sprite = Sprite();
entry_sprite = Sprite();
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 20, Window.GetY() + height - 45, 105);
fun center_text(sprite, text, y)
{
    image = Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 14");
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (width - image.GetWidth()) / 2,
                       Window.GetY() + height * y, 101);
}
fun display_normal()
{
    panel.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
}
fun display_prompt(prompt, answer)
{
    panel.SetOpacity(1);
    center_text(prompt_sprite, prompt, 0.43);
    center_text(entry_sprite, answer, 0.51);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
}
fun display_password(prompt, bullets)
{
    answer = "";
    for (i = 0; i < bullets; i++) answer += "*";
    display_prompt(prompt, answer);
}
fun display_message(text)
{
    message_sprite.SetImage(Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 12"));
    message_sprite.SetOpacity(1);
}
fun hide_message(text) { message_sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_prompt);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
tick = 0;
fun refresh()
{
    if (width != Window.GetWidth() || height != Window.GetHeight() ||
        window_x != Window.GetX() || window_y != Window.GetY()) resize_layout();
    seconds = tick / fps;
    fade = 1 - Math.Clamp((seconds - fade_start) / fade_duration, 0, 1);
    complete = seconds >= assembly_time;
    assembled_sprite.SetOpacity(complete);
    show_panel(left_face, left, left_face_image, left_image, direction["left"], sample(lighting["left"], seconds),
               origin_x + Math.Int(bounds["left"][0] * scale_x), origin_y + Math.Int(bounds["left"][1] * scale_y), 1, fade, complete);
    show_panel(right_face, right, right_face_image, right_image, direction["right"], sample(lighting["right"], seconds),
               origin_x + Math.Int(bounds["right"][0] * scale_x), origin_y + Math.Int(bounds["right"][1] * scale_y), 2, fade, complete);
    show_panel(bottom_face, bottom, bottom_face_image, bottom_image, direction["bottom"], sample(lighting["bottom"], seconds),
               origin_x + Math.Int(bounds["bottom"][0] * scale_x), origin_y + Math.Int(bounds["bottom"][1] * scale_y), 3, fade, complete);
    show_panel(top_face, top, top_face_image, top_image, direction["top"], sample(lighting["top"], seconds),
               origin_x + Math.Int(bounds["top"][0] * scale_x), origin_y + Math.Int(bounds["top"][1] * scale_y), 4, fade, complete);
    tick++;
}
Plymouth.SetRefreshRate(fps);
resize_layout();
refresh();
Plymouth.SetRefreshFunction(refresh);
