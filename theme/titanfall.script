# Generated configuration and palette.
@MOTION_SETUP@
Window.SetBackgroundTopColor(@BG@, @BG@, @BG@);
Window.SetBackgroundBottomColor(@BG@, @BG@, @BG@);
width = Window.GetWidth(); height = Window.GetHeight();
scale_x = width / 960; scale_y = height / 540;
origin_x = Window.GetX(); origin_y = Window.GetY();
window_x = origin_x; window_y = origin_y;
assembled_original = Image("assembled.png");
assembled_sprite = Sprite(); assembled_sprite.SetOpacity(0);
lines_original = Image("lines.png");
lines_dim = Sprite(); lines_bright = Sprite();
for (load_index = 0; panel_order[load_index]; load_index++)
{
    surfaces[panel_order[load_index]].sprite = Sprite();
    surfaces[panel_order[load_index]].frame = -1;
}
fun fit_panel(image, rectangle)
{
    target_width = Math.Int((rectangle[0]+rectangle[2])*scale_x)-Math.Int(rectangle[0]*scale_x);
    target_height = Math.Int((rectangle[1]+rectangle[3])*scale_y)-Math.Int(rectangle[1]*scale_y);
    return image.Scale(Math.Max(1,target_width),Math.Max(1,target_height));
}
fun resize_layout()
{
    global.width = Window.GetWidth(); global.height = Window.GetHeight();
    global.origin_x = Window.GetX(); global.origin_y = Window.GetY();
    global.window_x = origin_x; global.window_y = origin_y;
    global.scale_x = width/960; global.scale_y = height/540;
    global.lines_image = lines_original.Scale(width,height);
    lines_dim.SetImage(lines_image); lines_dim.SetPosition(origin_x,origin_y,20);
    for (local.i = 0; panel_order[local.i]; local.i++)
    {
        local.name = panel_order[local.i];
        if (surfaces[local.name].original)
            surfaces[local.name].image = fit_panel(surfaces[local.name].original,bounds[local.name]);
    }
    assembled_sprite.SetImage(assembled_original.Scale(width,height));
    assembled_sprite.SetPosition(origin_x,origin_y,-100);
    if (panel)
    {
        panel.SetImage(Image("panel.png").Scale(width,Math.Max(100,height*0.23)));
        panel.SetPosition(origin_x,origin_y+height*0.39,100);
    }
    if (message_sprite) message_sprite.SetPosition(origin_x+20,origin_y+height-45,105);
}
fun sample(keys, seconds)
{
    if (seconds <= keys[0][0]) return keys[0][1];
    for (local.index = 1; keys[local.index]; local.index++)
    {
        if (seconds <= keys[local.index][0])
        {
            previous = keys[local.index - 1];
            next = keys[local.index];
            fraction = (seconds - previous[0]) / (next[0] - previous[0]);
            return previous[1] + fraction * (next[1] - previous[1]);
        }
    }
    return keys[local.index - 1][1];
}
# Authentication stays readable throughout the sequence and after the final fade.
panel = Sprite(Image("panel.png").Scale(width, Math.Max(100, height * 0.23)));
panel.SetPosition(Window.GetX(), Window.GetY() + height * 0.39, 100);
panel.SetOpacity(0);
prompt_sprite = Sprite();
entry_sprite = Sprite();
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 20, Window.GetY() + height - 45, 105);
fun center_text(sprite, text, y)
{
    image = Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 14");
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (width - image.GetWidth()) / 2,
                       Window.GetY() + height * y, 101);
}
fun display_normal()
{
    panel.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
}
fun display_prompt(prompt, answer)
{
    panel.SetOpacity(1);
    center_text(prompt_sprite, prompt, 0.43);
    center_text(entry_sprite, answer, 0.51);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
}
fun display_password(prompt, bullets)
{
    answer = "";
    for (i = 0; i < bullets; i++) answer += "*";
    display_prompt(prompt, answer);
}
fun display_message(text)
{
    message_sprite.SetImage(Image.Text(text, @FG@, @FG@, @FG@, 1, "Sans 12"));
    message_sprite.SetOpacity(1);
}
fun hide_message(text) { message_sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_prompt);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
tick = 0;
fun refresh()
{
    if (width != Window.GetWidth() || height != Window.GetHeight() ||
        window_x != Window.GetX() || window_y != Window.GetY()) resize_layout();
    local.seconds = tick/fps;
    local.complete = local.seconds >= assembly_time;
    assembled_sprite.SetOpacity(local.complete);
    for (local.i = 0; panel_order[local.i]; local.i++)
    {
        local.name = panel_order[local.i];
        local.entry = surfaces[local.name];
        local.p = sample(lighting[local.name],local.seconds);
        local.entry.sprite.SetOpacity(0);
        if (!local.complete && local.p > 0)
        {
            local.frame = Math.Int(local.p*(frame_count[local.name]-1));
            if (local.entry.frame != local.frame)
            {
                local.entry.original = Image("face-"+local.name+"-"+local.frame+".png");
                local.entry.image = fit_panel(local.entry.original,bounds[local.name]);
                local.entry.frame = local.frame;
            }
            local.entry.sprite.SetImage(local.entry.image);
            local.entry.sprite.SetPosition(origin_x+Math.Int(bounds[local.name][0]*scale_x),
                origin_y+Math.Int(bounds[local.name][1]*scale_y),1+local.i);
            local.entry.sprite.SetOpacity(local.p*local.p*(3-2*local.p));
        }
    }
    # Only the center-out clipping window changes; outline coordinates stay fixed.
    local.fade = 1-Math.Clamp((local.seconds-fade_start)/fade_duration,0,1);
    lines_dim.SetOpacity(line_idle*local.fade);
    local.fill = Math.Clamp((local.seconds-fill_start)/fill_duration,0,1);
    lines_bright.SetOpacity(0);
    if (local.fill > 0)
    {
        local.w = Math.Max(1,Math.Int(width*local.fill));
        local.h = Math.Max(1,Math.Int(height*local.fill));
        local.x = Math.Int((width-local.w)/2); local.y = Math.Int((height-local.h)/2);
        lines_bright.SetImage(lines_image.Crop(local.x,local.y,local.w,local.h));
        lines_bright.SetPosition(origin_x+local.x,origin_y+local.y,21);
        lines_bright.SetOpacity(local.fade);
    }
    tick++;
}
Plymouth.SetRefreshRate(fps);
resize_layout(); refresh();
Plymouth.SetRefreshFunction(refresh);
